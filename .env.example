# =============================================================================
# Run tests (required to clone and run Playwright)
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# Base URL of the Didaxis environment under test
DIDAXIS_URL=https://test.didaxis.studio

# Admin email used by auth.setup.ts (storageState login)
DIDAXIS_EMAIL=your-admin@example.com

# Admin password used by auth.setup.ts
DIDAXIS_PASSWORD=replace-me

# Bearer token for program create/delete API cleanup (DELETE /api/programs/:id)
DIDAXIS_API_TOKEN=replace-me-api-token

# Optional — second account for permission / non-admin probes
# (Some specs currently read DIDAXIS_NONADMIN_EMAIL / DIDAXIS_NONADMIN_PASSWORD;
#  set those to the same values if you run permission tests.)
DIDAXIS_ALT_EMAIL=your-alt@example.com
DIDAXIS_ALT_PASSWORD=replace-me-alt

# =============================================================================
# Agent / CI setup (not needed for `npx playwright test` alone)
# Headless agent: .github/workflows/test-generation.yml
# MCP / Atlassian tokens also go in Cursor Settings → MCP when working locally.
# =============================================================================

# Cursor API key for headless `agent` CLI in CI
CURSOR_API_KEY=replace-me-cursor-api-key

# Atlassian API token (Jira) for backlog / bug-reporter agents
ATLASSIAN_API_TOKEN=replace-me-atlassian-api-token

# Atlassian site base URL (e.g. https://your-org.atlassian.net)
ATLASSIAN_BASE_URL=https://your-org.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN
ATLASSIAN_EMAIL=your-atlassian@example.com
